# Copy this file to .dev.vars (never commit .dev.vars) and fill in the values.
# See docs/accounts-setup.md for where each one comes from.
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get the admin role (club officers running the site).
ADMIN_EMAILS=
# The club code members enter at /join. Case does not matter.
CLUB_CODE=
