---
import '../styles/global.css';
import '../styles/print.css';
import { isCurrentPath } from '../lib/nav';
import { officialLinks } from '../data/competition';
import { focus } from '../lib/styles';
import { firstName, isProfileComplete } from '../lib/profile';

interface Props {
  title: string;
  description?: string;
  /** Ask search engines not to index this page (e.g. draft modules). */
  noindex?: boolean;
}

const {
  title,
  noindex = false,
  description = 'A step-by-step guide for GHIC members entering the YIS Global Stock Pitch Competition.',
} = Astro.props;

const siteName = 'GHIC Stock Pitch Guide';
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;

const navLinks = [
  { href: '/learn', label: 'Learn' },
  { href: '/tools', label: 'Tools' },
  { href: '/rules', label: 'Rules' },
  { href: '/glossary', label: 'Glossary' },
];

const currentPath = Astro.url.pathname;

// Account link. On-demand pages know who is signed in. Prerendered pages are
// built for everyone, so they say "Sign in" and the script at the bottom
// swaps in the first name from the ghic_nav cookie (see src/lib/navHint.ts).
// Without JavaScript the link still goes to /account, which shows the account.
const { user, profile } = Astro.locals;
const accountLink =
  user && profile && profile.name && isProfileComplete(profile)
    ? {
        href: profile.role === 'admin' ? '/admin/mentors' : '/account',
        label: firstName(profile.name),
        hint: false,
      }
    : user
      ? { href: '/join', label: 'Finish sign-up', hint: false }
      : { href: '/account', label: 'Sign in', hint: true };
const accountCurrent = ['/account', '/join', '/admin'].some((href) => isCurrentPath(currentPath, href));
const guidelines = officialLinks.find((link) => link.id === 'guidelines')!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Big+Shoulders+Display:wght@600;700;800;900&display=swap"
    />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip bg-bg font-sans text-text antialiased">
    <a
      href="#main"
      class="no-print sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast"
    >
      Skip to main content
    </a>

    <!-- Sticky from sm up only, so it doesn't take up a small phone screen. -->
    <header class="site-header z-40 border-b border-border bg-bg/85 backdrop-blur-md sm:sticky sm:top-0">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-gutter py-3 sm:px-8"
      >
        <a
          href="/"
          class:list={['rounded font-display text-2xl font-extrabold tracking-wide text-text no-underline', focus]}
          aria-current={isCurrentPath(currentPath, '/') ? 'page' : undefined}
        >
          GHIC Stock <span class="text-accent">Pitch</span> Guide
        </a>
        <nav aria-label="Main" class="no-print -mx-3 sm:mx-0">
          <ul class="flex flex-wrap gap-x-1 gap-y-1">
            {
              navLinks.map(({ href, label }) => {
                const current = isCurrentPath(currentPath, href);
                return (
                  <li>
                    <a
                      href={href}
                      aria-current={current ? 'page' : undefined}
                      class:list={[
                        'relative inline-block rounded-md px-3 py-2 font-bold no-underline transition-colors duration-200 hover:bg-tint hover:text-text',
                        // Current page: ink text with a foil bar underneath
                        current
                          ? 'text-text after:absolute after:inset-x-3 after:bottom-0.5 after:h-1 after:rounded-full after:bg-highlight'
                          : 'text-muted',
                        focus,
                      ]}
                    >
                      {label}
                    </a>
                  </li>
                );
              })
            }
            <li>
              <a
                href={accountLink.href}
                data-nav-account={accountLink.hint ? '' : undefined}
                aria-current={accountCurrent && isCurrentPath(currentPath, accountLink.href) ? 'page' : undefined}
                class:list={[
                  'relative inline-block max-w-[12rem] truncate rounded-md px-3 py-2 font-bold no-underline transition-colors duration-200 hover:bg-tint hover:text-text',
                  accountCurrent
                    ? 'text-text after:absolute after:inset-x-3 after:bottom-0.5 after:h-1 after:rounded-full after:bg-highlight'
                    : 'text-accent',
                  focus,
                ]}
              >
                {accountLink.label}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-gutter pt-10 pb-section sm:px-8 sm:pt-14">
      <slot />
    </main>

    <footer class="no-print border-t border-border bg-surface">
      <div class="mx-auto max-w-6xl px-gutter py-8 text-sm text-muted sm:px-8">
        <p>
          A study guide made by GHIC (Green Hope Investing Club) for its members.
        </p>
        <p class="mt-1">
          An independent GHIC study guide, not an official YIS resource.{' '}
          <a href={guidelines.url} class="font-bold">Official YIS guidelines and rubric</a>
        </p>
        <p class="mt-1">
          <a href="/privacy" class="font-bold">Privacy</a>
        </p>
      </div>
    </footer>
    <script>
      // Show the signed-in member's first name on prerendered pages.
      import { readNavHint } from '../lib/navHint';
      const link = document.querySelector<HTMLAnchorElement>('a[data-nav-account]');
      const hint = link ? readNavHint(document.cookie) : null;
      if (link && hint) {
        link.textContent = hint.name;
        link.href = hint.href;
      }
    </script>
  </body>
</html>
