---
import BaseLayout from '../layouts/BaseLayout.astro';
import Todo from '../components/Todo.astro';
import { glossary } from '../data/glossary';
import { fadeUp } from '../lib/styles';
---

<BaseLayout title="Glossary">
  <header class:list={['max-w-prose', fadeUp]}>
    <h1 class="text-5xl font-black sm:text-6xl">Glossary</h1>
    <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight"></div>
  </header>
  <dl class="mt-10 max-w-prose divide-y divide-border rounded-xl border border-border bg-surface shadow-card">
    {
      glossary.map((entry) => (
        <div id={entry.id} class="px-5 py-5 sm:px-card">
          <dt class="font-display text-3xl font-extrabold text-accent">{entry.term}</dt>
          <dd class="mt-1">
            {'definition' in entry && entry.definition ? (
              <p>{entry.definition}</p>
            ) : (
              <Todo title="TODO: definition coming">
                <p>This definition hasn't been written yet.</p>
              </Todo>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</BaseLayout>
