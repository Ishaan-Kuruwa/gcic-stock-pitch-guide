---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { deleteSeason, seasonCounts } from '../../db/season';
import { denied, requireRole } from '../../lib/guards';
import { crossSiteResponse, isSameOrigin } from '../../lib/origin';
import { parseEmailList } from '../../lib/roles';
import { isSeasonConfirmed, SEASON_CONFIRM } from '../../lib/season';
import { buttonSecondary, card, eyebrow, fadeUp, focus, input } from '../../lib/styles';

export const prerender = false;

const access = requireRole(Astro.locals, 'admin');
if (!access.ok) return denied(Astro, access);
// Another site's POST is refused before anything else runs.
if (Astro.request.method === 'POST' && !isSameOrigin(Astro.request)) return crossSiteResponse();

Astro.response.headers.set('Cache-Control', 'private, no-store');

const db = getDb();
const adminEmails = parseEmailList(env.ADMIN_EMAILS as string | undefined);
let error = false;

// Post/Redirect/Get: a confirmed delete redirects with what was deleted.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (isSeasonConfirmed(form.get('confirm'))) {
    const deleted = await deleteSeason(db, adminEmails);
    const params = new URLSearchParams({
      status: 'deleted',
      accounts: String(deleted.menteeAccounts),
      teams: String(deleted.teams),
    });
    return Astro.redirect(`/admin/season?${params}`, 303);
  }
  error = true;
}

const counts = await seasonCounts(db, adminEmails);
const nothingToDelete = counts.menteeAccounts === 0 && counts.teams === 0;

const count = (name: string) => {
  const n = Number(Astro.url.searchParams.get(name));
  return Number.isInteger(n) && n >= 0 ? n : 0;
};
const deletedMessage =
  Astro.url.searchParams.get('status') === 'deleted'
    ? `Season deleted: ${plural(count('accounts'), 'member account')} and ${plural(count('teams'), 'team')}.`
    : null;

function plural(n: number, word: string): string {
  return `${n} ${word}${n === 1 ? '' : 's'}`;
}
---

<BaseLayout title="End of season" description="Delete this season's member accounts and teams." noindex>
  <div class:list={['max-w-prose', fadeUp]}>
    <p class={eyebrow}>Admin</p>
    <h1 class="mt-2 text-5xl font-black sm:text-6xl">End of season</h1>
    <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight"></div>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      When the competition is over, delete this season's member data, as the{' '}
      <a href="/privacy" class:list={['font-bold', focus]}>privacy page</a> promises. Officers and mentors keep their
      accounts, so next season starts with the same people running it.
    </p>

    {deletedMessage && <p role="status" class="mt-6 rounded-md bg-tint p-4 font-bold">{deletedMessage}</p>}

    <section aria-labelledby="deleted" class:list={['mt-8', card]}>
      <h2 id="deleted" class="text-3xl font-extrabold">What will be deleted</h2>
      <ul class="mt-4 list-disc space-y-2 pl-6">
        <li>
          <strong>{plural(counts.menteeAccounts, 'member account')}</strong>, each with its profile (name and grade),
          sign-in sessions and module progress.
        </li>
        <li>
          <strong>{plural(counts.teams, 'team')}</strong> and everything on them:{' '}
          {`${plural(counts.teamMembers, 'member')}, ${plural(counts.teamLinks, 'file link')}, ${plural(counts.milestones, 'ticked milestone')} and ${plural(counts.checkins, 'check-in')}`}.
        </li>
      </ul>
      <p class="mt-4">
        It can't be undone. Files in Google Drive (reports, slides, spreadsheets) aren't touched: this site only
        stores links to them.
      </p>
    </section>

    <section aria-labelledby="kept" class:list={['mt-6', card]}>
      <h2 id="kept" class="text-3xl font-extrabold">What is kept</h2>
      <ul class="mt-4 list-disc space-y-2 pl-6">
        <li><strong>{plural(counts.admins, 'admin account')}</strong> (club officers).</li>
        <li><strong>{plural(counts.mentors, 'mentor account')}</strong>.</li>
        <li>The mentor list: <strong>{plural(counts.mentorList, 'email')}</strong>.</li>
      </ul>
    </section>

    {
      nothingToDelete ? (
        <p class="mt-8 rounded-md bg-tint p-4 font-bold">There are no member accounts or teams to delete.</p>
      ) : (
        <section aria-labelledby="confirm-heading" class:list={['mt-8', card]}>
          <h2 id="confirm-heading" class="text-3xl font-extrabold">
            Delete the season
          </h2>
          <p class="mt-3">
            <a href="/admin/teams.csv" download class:list={['font-bold', focus]}>
              Download a copy first
            </a>{' '}
            (the All teams table as a CSV file, without emails or check-in notes).
          </p>
          <form method="post" class="mt-6">
            <label for="confirm" class="block text-lg font-bold">
              Type <span class="tracking-wide">{SEASON_CONFIRM}</span> to confirm
            </label>
            {error && (
              <p id="confirm-error" role="alert" class="mt-2 rounded-md border-2 border-danger p-3 font-bold text-danger">
                Error: Nothing was deleted. Type {SEASON_CONFIRM} exactly, in capitals.
              </p>
            )}
            <input
              id="confirm"
              name="confirm"
              type="text"
              required
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              aria-invalid={error ? 'true' : undefined}
              aria-describedby={error ? 'confirm-error' : undefined}
              class:list={['mt-2', input]}
            />
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <button
                type="submit"
                class:list={[
                  'inline-flex cursor-pointer items-center justify-center rounded-md bg-danger px-6 py-3 text-lg font-bold text-danger-contrast',
                  focus,
                ]}
              >
                Delete member accounts and teams
              </button>
              <a href="/admin/teams" class:list={[buttonSecondary, focus]}>
                Cancel
              </a>
            </div>
          </form>
        </section>
      )
    }

    <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/admin/teams" class:list={['font-bold', focus]}>All teams</a>
      <a href="/admin/mentors" class:list={['font-bold', focus]}>Manage mentors</a>
    </p>
  </div>
</BaseLayout>
