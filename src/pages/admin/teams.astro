---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mentorship } from '../../data/club';
import { getDb } from '../../db/client';
import { getTeamsOverview } from '../../db/mentorship';
import { formatShortDate } from '../../lib/format';
import { denied, requireRole } from '../../lib/guards';
import { overviewRows } from '../../lib/mentorship';
import { todayIn } from '../../lib/milestones';
import { eyebrow, fadeUp, focus } from '../../lib/styles';

export const prerender = false;

const access = requireRole(Astro.locals, 'admin');
if (!access.ok) return denied(Astro, access);

Astro.response.headers.set('Cache-Control', 'private, no-store');

const today = todayIn();
const rows = overviewRows(await getTeamsOverview(getDb()), today);
const flagged = rows.filter((r) => r.flag).length;
---

<BaseLayout title="All teams" description="Every GHIC team's progress and mentoring." noindex>
  <div class:list={['max-w-prose', fadeUp]}>
    <p class={eyebrow}>Admin</p>
    <h1 class="mt-2 text-5xl font-black sm:text-6xl">All teams</h1>
    <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight"></div>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      Every team's milestones, mentor and latest check-in, as of {formatShortDate(today)}. Mentored teams that need
      attention are listed first: no mentor, no check-ins yet, or no check-in in {mentorship.checkinEveryDays}+ days.
      Open a team to set its mentorship status and mentor.
    </p>
    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/mentor" class:list={['font-bold', focus]}>Teams I mentor</a>
      <a href="/admin/mentors" class:list={['font-bold', focus]}>Manage mentors</a>
      <a href="/admin/teams.csv" download class:list={['font-bold', focus]}>Download CSV</a>
      <a href="/admin/season" class:list={['font-bold', focus]}>End of season</a>
    </p>
    <p class="mt-6 text-lg font-bold">
      {rows.length} {rows.length === 1 ? 'team' : 'teams'}, {flagged} {flagged === 1 ? 'needs' : 'need'} attention.
    </p>
  </div>

  {
    rows.length === 0 ? (
      <p class="mt-6 text-muted">No teams yet.</p>
    ) : (
      <div
        role="region"
        aria-labelledby="teams-caption"
        tabindex="0"
        class:list={['mt-6 max-w-full overflow-x-auto rounded-xl border border-border bg-surface shadow-card', focus]}
      >
        <table class="w-full min-w-[64rem] border-collapse text-left">
          <caption id="teams-caption" class="sr-only">
            All teams, mentored teams needing attention first. Scrolls sideways on small screens.
          </caption>
          <thead class="bg-tint">
            <tr>
              {['Team', 'Members', 'Company', 'Status', 'Mentor', 'Milestones', 'Next due', 'Last check-in', 'Attention'].map(
                (h) => (
                  <th scope="col" class="px-3 py-2 align-bottom text-sm font-bold">
                    {h}
                  </th>
                ),
              )}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-t border-border align-top">
                <th scope="row" class="px-3 py-3 font-bold">
                  <a href={`/team/${r.id}`} class:list={['break-words', focus]}>
                    {r.name}
                  </a>
                </th>
                <td class="px-3 py-3">{r.members || 'No members'}</td>
                <td class="px-3 py-3 break-words">{r.company}</td>
                <td class="px-3 py-3">{r.statusLabel}</td>
                <td class="px-3 py-3 break-words">
                  {r.mentor ?? (r.status === 'mentored' ? <strong>Needs a mentor</strong> : <span class="text-muted">None</span>)}
                </td>
                <td class="px-3 py-3 whitespace-nowrap">
                  {r.done} of {r.total}
                </td>
                <td class="px-3 py-3">
                  {r.nextDue ? (
                    <>
                      {r.nextDue.label}
                      <span class:list={['block text-sm', r.nextDue.status.state === 'late' ? 'font-bold' : 'text-muted']}>
                        <time datetime={r.nextDue.status.date}>{r.nextDue.status.text}</time>
                      </span>
                    </>
                  ) : (
                    'All done'
                  )}
                </td>
                <td class="px-3 py-3">
                  {r.lastCheckin ? <time datetime={r.lastMetOn!}>{r.lastCheckin}</time> : <span class="text-muted">None</span>}
                </td>
                <td class="px-3 py-3">{r.flagText ? <strong>{r.flagText}</strong> : <span class="text-muted">None</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</BaseLayout>
