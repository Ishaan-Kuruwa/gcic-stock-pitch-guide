---
import ModuleRef from '../../components/ModuleRef.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubmissionCheck from '../../components/SubmissionCheck.tsx';
import { officialLinks } from '../../data/competition';
import { eyebrow, fadeUp } from '../../lib/styles';

const guidelines = officialLinks.find((l) => l.id === 'guidelines')!;
---

<BaseLayout
  title="Submission Check"
  description="Tick off every YIS requirement for your submission email before you hit send."
>
  <header class:list={['max-w-prose', fadeUp]}>
    <p class={eyebrow}><a href="/tools" class="text-muted">Tools</a></p>
    <h1 class="mt-2 text-5xl font-black sm:text-6xl">Submission Check</h1>
    <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight"></div>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      Open your email draft next to this page. Tick each item only after you've checked it in
      the draft itself. Your ticks are saved in this browser.
    </p>
    <p class="mt-3 text-sm text-muted">
      This list comes from the YIS <a href={guidelines.url}>{guidelines.label.toLowerCase()}</a>.
      If anything here disagrees with that page, follow YIS. See module 10,
      <ModuleRef number={10}>Submit</ModuleRef>.
    </p>
  </header>

  <div class="mt-10">
    <SubmissionCheck client:visible />
  </div>
</BaseLayout>
