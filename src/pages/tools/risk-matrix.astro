---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RiskMatrix from '../../components/RiskMatrix.tsx';
import { eyebrow, fadeUp } from '../../lib/styles';
---

<BaseLayout
  title="Risk Matrix"
  description="Rate your investment risks by likelihood and impact, and sort them by how much they matter."
>
  <header class:list={['max-w-prose', fadeUp]}>
    <p class={eyebrow}><a href="/tools" class="text-muted">Tools</a></p>
    <h1 class="mt-2 text-5xl font-black sm:text-6xl">Risk Matrix</h1>
    <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight"></div>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      Type in the risks you found in module 6, rate how likely each one is and how much damage it
      would do, and add a mitigant. The tool sorts them by likelihood × impact.
    </p>
    <p class="mt-3 text-sm text-muted">
      The tool only organizes what you type. Every risk and mitigant must be your own words. Your
      risks are saved in this browser.
    </p>
  </header>

  <div class="mt-10">
    <RiskMatrix client:visible />
  </div>
</BaseLayout>
