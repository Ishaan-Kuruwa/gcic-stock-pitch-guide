---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotFound from '../../../components/NotFound.astro';
import { getDb } from '../../../db/client';
import { getTeam, leaveTeam } from '../../../db/teams';
import { denied, requireProfile } from '../../../lib/guards';
import { crossSiteResponse, isSameOrigin } from '../../../lib/origin';
import { buttonSecondary, card, eyebrow, fadeUp, focus } from '../../../lib/styles';

export const prerender = false;

const access = requireProfile(Astro.locals);
if (!access.ok) return denied(Astro, access);

Astro.response.headers.set('Cache-Control', 'private, no-store');

const db = getDb();
const teamId = Astro.params.id ?? '';
const view = await getTeam(db, teamId);
// Only members can leave. Anyone else gets the same 404 as a missing team.
const isMember = !!view && view.members.some((m) => m.userId === access.user.id);
const lastMember = isMember && view!.members.length === 1;

let failed = false;
if (!isMember) {
  Astro.response.status = 404;
} else if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return crossSiteResponse();
  try {
    const result = await leaveTeam(db, access.user.id);
    return Astro.redirect(`/account?left=${result === 'team-deleted' ? 'deleted' : '1'}`, 303);
  } catch (error) {
    console.error('Leaving a team failed', error);
    failed = true;
  }
}
---

{
  !isMember || !view ? (
    <NotFound noindex />
  ) : (
    <BaseLayout title="Leave team" description="Leave your GHIC stock pitch team." noindex>
      <div class:list={['max-w-prose', fadeUp]}>
        <p class={eyebrow}>Team</p>
        <h1 class="mt-2 text-5xl font-black sm:text-6xl">Leave team</h1>
        <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight" />
        <p class="mt-5 text-lg leading-relaxed text-muted">
          {lastMember
            ? "You're the only member, so leaving deletes the team, its company and ticker, its links and its check-in notes. It can't be undone."
            : 'Your teammate keeps the team, its company and its links. You can join again later with the join code.'}
        </p>

        {failed && (
          <p role="alert" class="mt-6 rounded-md border-2 border-danger p-4 font-bold text-danger">
            Error: We couldn't take you off the team. Please try again.
          </p>
        )}

        <section aria-labelledby="confirm" class:list={['mt-8', card]}>
          <h2 id="confirm" class="text-3xl font-extrabold">
            Are you sure?
          </h2>
          <p class="mt-3">
            Leave <strong class="break-words">{view.team.name}</strong>?
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <form method="post">
              <button
                type="submit"
                class:list={[
                  'inline-flex cursor-pointer items-center justify-center rounded-md bg-danger px-6 py-3 text-lg font-bold text-danger-contrast',
                  focus,
                ]}
              >
                {lastMember ? 'Yes, leave and delete the team' : 'Yes, leave the team'}
              </button>
            </form>
            <a href={`/team/${view.team.id}`} class:list={[buttonSecondary, focus]}>
              Cancel
            </a>
          </div>
        </section>
      </div>
    </BaseLayout>
  )
}
