---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb } from '../db/client';
import { getModuleProgress } from '../db/progress';
import { getTeam, getTeamIdForUser } from '../db/teams';
import { denied, requireProfile } from '../lib/guards';
import { moduleCatalog, type CatalogItem } from '../lib/modules';
import { roleLabels } from '../lib/roles';
import { buttonPrimary, buttonSecondary, card, eyebrow, fadeUp, focus } from '../lib/styles';

// Rendered per visit (shows who is signed in); every other page stays static.
export const prerender = false;

// Signed out: this page is the sign-in page. Signed in: the profile must be
// finished first, so an unfinished one goes to /join.
const { user } = Astro.locals;
const access = user ? requireProfile(Astro.locals) : null;
if (access && !access.ok) return denied(Astro, access);
const profile = access?.ok ? access.profile : null;
const deleted = Astro.url.searchParams.get('deleted') === '1';
const left = Astro.url.searchParams.get('left');
const leftMessage =
  left === 'deleted'
    ? 'You left the team. You were the last member, so the team and its links are deleted.'
    : left === '1'
      ? 'You left the team.'
      : null;

// Members (mentees) see their team, or buttons to create or join one.
let team: { id: string; name: string; company: string | null; ticker: string | null } | null = null;
if (user && profile?.role === 'mentee') {
  const db = getDb();
  const teamId = await getTeamIdForUser(db, user.id);
  const view = teamId ? await getTeam(db, teamId) : null;
  if (view) team = view.team;
}
// Everyone with a finished profile sees their modules, done or not.
let modules: (CatalogItem & { done: boolean })[] = [];
if (user && profile) {
  const done = new Set(await getModuleProgress(getDb(), user.id));
  modules = moduleCatalog(await getCollection('modules')).map((m) => ({ ...m, done: done.has(m.slug) }));
}
const doneCount = modules.filter((m) => m.done).length;
const error = Astro.url.searchParams.get('error');
const errorMessage =
  error === null
    ? null
    : error === 'signout'
      ? "We couldn't sign you out. Please try again."
      : "Sign-in didn't finish. Please try again. If it keeps failing, your school account may block this app: try a personal Google account.";

// Personal page: never cache it in a shared cache.
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout title="Account" description="Sign in to the GHIC Stock Pitch Guide." noindex>
  <div class:list={['max-w-prose', fadeUp]}>
    <p class={eyebrow}>Account</p>
    <h1 class="mt-2 text-5xl font-black sm:text-6xl">Your account</h1>
    <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight"></div>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      {
        user
          ? 'You are signed in. We keep only your name, the email you sign in with, your grade, which modules you have done, and your team, its milestones and file links.'
          : 'Sign in with your Google account. We keep only your name, email and grade.'
      }{' '}
      <a href="/privacy" class:list={['font-bold', focus]}>Privacy</a>
    </p>

    {
      deleted && !user && (
        <p role="status" class="mt-6 rounded-md bg-tint p-4 font-bold">
          Your account is deleted and you are signed out.
        </p>
      )
    }

    {
      errorMessage && (
        <p role="alert" class="mt-6 rounded-md border-2 border-danger p-4 font-bold text-danger">
          Error: {errorMessage}
        </p>
      )
    }

    {
      user && profile ? (
        <>
          <section aria-labelledby="signed-in" class:list={['mt-8', card]}>
            <h2 id="signed-in" class="text-3xl font-extrabold">
              Signed in
            </h2>
            <dl class="mt-4 space-y-3">
              <div>
                <dt class="text-sm font-bold text-muted">Name</dt>
                <dd class="break-words text-lg">{profile.name}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold text-muted">Email</dt>
                <dd class="break-words text-lg">{user.email}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold text-muted">Grade</dt>
                <dd class="text-lg">{profile.grade}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold text-muted">Role</dt>
                <dd class="text-lg">{roleLabels[profile.role]}</dd>
              </div>
            </dl>
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <form method="post" action="/account/sign-out">
                <button type="submit" class:list={[buttonSecondary, focus, 'cursor-pointer']}>
                  Sign out
                </button>
              </form>
              {profile.role === 'admin' && (
                <a href="/admin/mentors" class:list={['font-bold', focus]}>
                  Manage mentors
                </a>
              )}
            </div>
          </section>
          {profile.role === 'mentee' && (
            <section aria-labelledby="team-heading" class:list={['mt-8', card]}>
              <h2 id="team-heading" class="text-3xl font-extrabold">
                Your team
              </h2>
              {leftMessage && (
                <p role="status" class="mt-4 rounded-md bg-tint p-4 font-bold">
                  {leftMessage}
                </p>
              )}
              {team ? (
                <>
                  <p class="mt-3 break-words text-2xl font-bold">{team.name}</p>
                  <p class="mt-1 break-words text-muted">
                    {team.company
                      ? `${team.company}${team.ticker ? ` (${team.ticker})` : ''}`
                      : 'No company chosen yet'}
                  </p>
                  <a href={`/team/${team.id}`} class:list={['mt-6', buttonPrimary, focus]}>
                    Go to your team
                  </a>
                </>
              ) : (
                <>
                  <p class="mt-3">You're not on a team yet.</p>
                  <div class="mt-6 flex flex-wrap items-center gap-4">
                    <a href="/team/new" class:list={[buttonPrimary, focus]}>
                      Create a team (or compete solo)
                    </a>
                    <a href="/team/join" class:list={[buttonSecondary, focus]}>
                      Join with a code
                    </a>
                  </div>
                </>
              )}
            </section>
          )}
          <section aria-labelledby="modules-heading" class:list={['mt-8', card]}>
            <h2 id="modules-heading" class="text-3xl font-extrabold">
              Your modules
            </h2>
            <p class="mt-3">
              {doneCount} of {modules.length} done. While you're signed in, the ticks you make on the{' '}
              <a href="/learn#progress" class:list={['font-bold', focus]}>Learn page</a> are saved to your
              account.
            </p>
            <ul class="mt-4 space-y-2">
              {modules.map((m) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 border-b border-border pb-2 last:border-0">
                  <span class="min-w-0 break-words">
                    <span class="text-muted">Module {m.number}: </span>
                    {m.href ? (
                      <a href={m.href} class:list={['font-bold', focus]}>
                        {m.title}
                      </a>
                    ) : (
                      <span class="font-bold">{m.title}</span>
                    )}
                  </span>
                  <span class:list={[m.done ? 'font-bold' : 'text-muted']}>{m.done ? 'Done' : 'Not done'}</span>
                </li>
              ))}
            </ul>
          </section>
          <section aria-labelledby="delete-heading" class="mt-10">
            <h2 id="delete-heading" class="text-2xl font-extrabold">
              Delete my account
            </h2>
            <p class="mt-2 text-muted">
              Removes your name, grade, module progress, team membership and sign-in records from this
              site. You'll be asked to confirm.
            </p>
            <a href="/account/delete" class:list={['mt-4', buttonSecondary, focus]}>
              Delete my account
            </a>
          </section>
        </>
      ) : (
        <>
          <p class="mt-8 rounded-md bg-tint p-4">
            <strong>Use a personal Google account. School accounts are blocked by the district.</strong>{' '}
            A school account shows "Access blocked" or "Error 400". After you sign in for the first
            time, you'll enter your grade and the club code.
          </p>
          <form method="post" action="/account/sign-in" class="mt-6">
            <button type="submit" class:list={[buttonPrimary, focus, 'cursor-pointer']}>
              Sign in with Google
            </button>
          </form>
        </>
      )
    }
  </div>
</BaseLayout>
