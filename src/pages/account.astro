---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buttonPrimary, buttonSecondary, card, eyebrow, fadeUp, focus } from '../lib/styles';

// Rendered per visit (shows who is signed in); every other page stays static.
export const prerender = false;

const { user } = Astro.locals;
const error = Astro.url.searchParams.get('error');
const errorMessage =
  error === null
    ? null
    : error === 'signout'
      ? "We couldn't sign you out. Please try again."
      : "Sign-in didn't finish. Please try again. If it keeps failing, your school account may block this app: try a personal Google account.";

// Personal page: never cache it in a shared cache.
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout title="Account" description="Sign in to the GHIC Stock Pitch Guide." noindex>
  <div class:list={['max-w-prose', fadeUp]}>
    <p class={eyebrow}>Account</p>
    <h1 class="mt-2 text-5xl font-black sm:text-6xl">Your account</h1>
    <div aria-hidden="true" class="decorative mt-5 h-1.5 w-20 rounded-full bg-highlight"></div>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      {
        user
          ? 'You are signed in. We keep only your name and email from Google.'
          : 'Sign in with your Google account. We keep only your name and email.'
      }
    </p>

    {
      errorMessage && (
        <p role="alert" class="mt-6 rounded-md border-2 border-danger p-4 font-bold text-danger">
          Error: {errorMessage}
        </p>
      )
    }

    {
      user ? (
        <section aria-labelledby="signed-in" class:list={['mt-8', card]}>
          <h2 id="signed-in" class="text-3xl font-extrabold">
            Signed in
          </h2>
          <dl class="mt-4 space-y-3">
            <div>
              <dt class="text-sm font-bold text-muted">Name</dt>
              <dd class="break-words text-lg">{user.name}</dd>
            </div>
            <div>
              <dt class="text-sm font-bold text-muted">Email</dt>
              <dd class="break-words text-lg">{user.email}</dd>
            </div>
          </dl>
          <form method="post" action="/account/sign-out" class="mt-6">
            <button type="submit" class:list={[buttonSecondary, focus, 'cursor-pointer']}>
              Sign out
            </button>
          </form>
        </section>
      ) : (
        <form method="post" action="/account/sign-in" class="mt-8">
          <button type="submit" class:list={[buttonPrimary, focus, 'cursor-pointer']}>
            Sign in with Google
          </button>
        </form>
      )
    }
  </div>
</BaseLayout>
